rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isMasterEmail() {
      return isSignedIn() && request.auth.token.email == 'drc.2015kolkata@gmail.com';
    }

    function isAdmin() {
      return isMasterEmail() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwnerOrAdmin() {
      return isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    function isListOwnerOrMaster() {
      return isSignedIn() && (resource.data.ownerUid == request.auth.uid || request.auth.token.email == 'drc.2015kolkata@gmail.com');
    }

    function isValidOptStr(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidOptNum(data, key) {
      return !(key in data) || (data[key] is int || data[key] is float);
    }

    // 3. Entity Validation Blueprints
    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
        data.keys().hasOnly(['email', 'displayName', 'createdAt']) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        isValidOptStr(data, 'displayName', 120) &&
        data.createdAt is timestamp;
    }

    function isValidStaffAccount(data) {
      return data.keys().hasAll(['staffCode', 'displayName', 'role', 'pinHash', 'active', 'permissions', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['staffCode', 'displayName', 'role', 'branchCode', 'pinHash', 'active', 'permissions', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.staffCode is string && data.staffCode.size() >= 2 && data.staffCode.size() <= 32 && data.staffCode.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100 &&
        data.role in ['Admin', 'Manager', 'Billing', 'Accounts', 'Dispatch', 'Viewer'] &&
        isValidOptStr(data, 'branchCode', 32) &&
        data.pinHash is string && data.pinHash.size() >= 4 && data.pinHash.size() <= 128 &&
        data.active is bool &&
        data.permissions is list && data.permissions.size() <= 12 &&
        (data.permissions.size() == 0 || data.permissions[0] is string) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidParty(data) {
      return data.keys().hasAll(['name', 'partyType', 'openingBalance', 'currentBalance', 'balanceType', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'partyType', 'address', 'gstin', 'pan', 'phone', 'email', 'openingBalance', 'currentBalance', 'balanceType', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 180 &&
        data.partyType in ['Customer', 'Consignor', 'Consignee', 'TruckOwner', 'Vendor'] &&
        isValidOptStr(data, 'address', 400) &&
        isValidOptStr(data, 'gstin', 20) &&
        isValidOptStr(data, 'pan', 15) &&
        isValidOptStr(data, 'phone', 30) &&
        isValidOptStr(data, 'email', 160) &&
        (data.openingBalance is int || data.openingBalance is float) &&
        (data.currentBalance is int || data.currentBalance is float) &&
        data.balanceType in ['Dr', 'Cr'] &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVehicle(data) {
      return data.keys().hasAll(['truckNo', 'ownerName', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['truckNo', 'vehicleType', 'ownerName', 'ownerPhone', 'engineNo', 'chassisNo', 'fitnessExpiry', 'insuranceExpiry', 'permitExpiry', 'pucExpiry', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.truckNo is string && data.truckNo.size() >= 4 && data.truckNo.size() <= 24 &&
        isValidOptStr(data, 'vehicleType', 80) &&
        data.ownerName is string && data.ownerName.size() <= 140 &&
        isValidOptStr(data, 'ownerPhone', 30) &&
        isValidOptStr(data, 'engineNo', 40) &&
        isValidOptStr(data, 'chassisNo', 40) &&
        isValidOptStr(data, 'fitnessExpiry', 20) &&
        isValidOptStr(data, 'insuranceExpiry', 20) &&
        isValidOptStr(data, 'permitExpiry', 20) &&
        isValidOptStr(data, 'pucExpiry', 20) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDriver(data) {
      return data.keys().hasAll(['name', 'dlNo', 'dlExpiry', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'dlNo', 'dlExpiry', 'phone', 'address', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
        data.dlNo is string && data.dlNo.size() >= 4 && data.dlNo.size() <= 40 &&
        data.dlExpiry is string && data.dlExpiry.size() <= 20 &&
        isValidOptStr(data, 'phone', 30) &&
        isValidOptStr(data, 'address', 300) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConsignment(data) {
      return data.keys().hasAll(['cnNo', 'cnDate', 'consignorName', 'consigneeName', 'truckNo', 'fromCity', 'toCity', 'totalFreight', 'billed', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'cnNo', 'cnDate', 'deliveryOffice', 'consignorName', 'consignorAddress', 'consignorGstin',
          'consigneeName', 'consigneeAddress', 'consigneeGstin', 'packages', 'particulars',
          'nettWeight', 'grossWeight', 'loadingCharge', 'unloadingCharge', 'returnLorryCharge', 'sttCharge',
          'totalFreight', 'paidAmount', 'toPayAmount', 'taxInvNo', 'taxInvDate', 'ewayBillNo', 'ewayBillDate',
          'valueOfGoods', 'truckNo', 'fromCity', 'toCity', 'engineNo', 'chassisNo', 'ownerName',
          'driverName', 'driverDlNo', 'gstPaidBy', 'insuranceStatus', 'billed', 'invoiceId',
          'branchCode', 'createdByStaff', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        data.cnNo is string && data.cnNo.size() >= 2 && data.cnNo.size() <= 40 &&
        data.cnDate is string && data.cnDate.size() >= 8 && data.cnDate.size() <= 20 &&
        isValidOptStr(data, 'deliveryOffice', 200) &&
        data.consignorName is string && data.consignorName.size() <= 180 &&
        isValidOptStr(data, 'consignorAddress', 350) &&
        isValidOptStr(data, 'consignorGstin', 24) &&
        data.consigneeName is string && data.consigneeName.size() <= 180 &&
        isValidOptStr(data, 'consigneeAddress', 350) &&
        isValidOptStr(data, 'consigneeGstin', 24) &&
        isValidOptStr(data, 'packages', 40) &&
        isValidOptStr(data, 'particulars', 400) &&
        isValidOptNum(data, 'nettWeight') &&
        isValidOptNum(data, 'grossWeight') &&
        isValidOptNum(data, 'loadingCharge') &&
        isValidOptNum(data, 'unloadingCharge') &&
        isValidOptNum(data, 'returnLorryCharge') &&
        isValidOptNum(data, 'sttCharge') &&
        (data.totalFreight is int || data.totalFreight is float) &&
        isValidOptNum(data, 'paidAmount') &&
        isValidOptNum(data, 'toPayAmount') &&
        isValidOptStr(data, 'taxInvNo', 80) &&
        isValidOptStr(data, 'taxInvDate', 20) &&
        isValidOptStr(data, 'ewayBillNo', 60) &&
        isValidOptStr(data, 'ewayBillDate', 20) &&
        isValidOptNum(data, 'valueOfGoods') &&
        data.truckNo is string && data.truckNo.size() <= 30 &&
        data.fromCity is string && data.fromCity.size() <= 120 &&
        data.toCity is string && data.toCity.size() <= 120 &&
        isValidOptStr(data, 'engineNo', 40) &&
        isValidOptStr(data, 'chassisNo', 40) &&
        isValidOptStr(data, 'ownerName', 140) &&
        isValidOptStr(data, 'driverName', 140) &&
        isValidOptStr(data, 'driverDlNo', 40) &&
        isValidOptStr(data, 'gstPaidBy', 40) &&
        isValidOptStr(data, 'insuranceStatus', 80) &&
        data.billed is bool &&
        isValidOptStr(data, 'invoiceId', 128) &&
        isValidOptStr(data, 'branchCode', 32) &&
        isValidOptStr(data, 'createdByStaff', 64) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['invoiceNo', 'invoiceDate', 'partyName', 'grandTotal', 'paidAmount', 'status', 'consignmentRows', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'invoiceNo', 'invoiceDate', 'dueDate', 'partyName', 'partyAddress', 'partyGstin', 'partyPan',
          'sac', 'reverseCharge', 'gstRate', 'cgstAmt', 'sgstAmt', 'igstAmt', 'totalTax',
          'freightCharges', 'detentionCharges', 'unloadingCharges', 'stCharges', 'grandTotal',
          'paidAmount', 'status', 'remarks', 'consignmentRows', 'annexureLorries',
          'branchCode', 'createdByStaff', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        data.invoiceNo is string && data.invoiceNo.size() >= 2 && data.invoiceNo.size() <= 40 &&
        data.invoiceDate is string && data.invoiceDate.size() >= 8 && data.invoiceDate.size() <= 20 &&
        isValidOptStr(data, 'dueDate', 20) &&
        data.partyName is string && data.partyName.size() >= 1 && data.partyName.size() <= 180 &&
        isValidOptStr(data, 'partyAddress', 350) &&
        isValidOptStr(data, 'partyGstin', 24) &&
        isValidOptStr(data, 'partyPan', 15) &&
        isValidOptStr(data, 'sac', 20) &&
        (!('reverseCharge' in data) || data.reverseCharge is bool) &&
        isValidOptNum(data, 'gstRate') &&
        isValidOptNum(data, 'cgstAmt') &&
        isValidOptNum(data, 'sgstAmt') &&
        isValidOptNum(data, 'igstAmt') &&
        isValidOptNum(data, 'totalTax') &&
        isValidOptNum(data, 'freightCharges') &&
        isValidOptNum(data, 'detentionCharges') &&
        isValidOptNum(data, 'unloadingCharges') &&
        isValidOptNum(data, 'stCharges') &&
        (data.grandTotal is int || data.grandTotal is float) &&
        (data.paidAmount is int || data.paidAmount is float) &&
        data.status in ['Unpaid', 'Partial', 'Paid'] &&
        isValidOptStr(data, 'remarks', 500) &&
        data.consignmentRows is list && data.consignmentRows.size() >= 1 && data.consignmentRows.size() <= 100 &&
        data.consignmentRows[0] is map &&
        (!('annexureLorries' in data) || (data.annexureLorries is list && data.annexureLorries.size() <= 100)) &&
        isValidOptStr(data, 'branchCode', 32) &&
        isValidOptStr(data, 'createdByStaff', 64) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidQuotation(data) {
      return data.keys().hasAll(['quotationNo', 'quotationDate', 'partyName', 'vehicleType', 'freight', 'destination', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'quotationNo', 'quotationDate', 'partyName', 'partyAddress', 'partyGstin', 'subject',
          'validityText', 'vehicleType', 'freight', 'loadingCharge', 'unloadingCharge',
          'parkingCharge', 'detentionCharge', 'tonGuarantee', 'destination', 'advancePay',
          'entryPoint', 'branchCode', 'createdByStaff', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        data.quotationNo is string && data.quotationNo.size() >= 2 && data.quotationNo.size() <= 40 &&
        data.quotationDate is string && data.quotationDate.size() >= 8 && data.quotationDate.size() <= 20 &&
        data.partyName is string && data.partyName.size() >= 1 && data.partyName.size() <= 180 &&
        isValidOptStr(data, 'partyAddress', 350) &&
        isValidOptStr(data, 'partyGstin', 24) &&
        isValidOptStr(data, 'subject', 200) &&
        isValidOptStr(data, 'validityText', 120) &&
        data.vehicleType is string && data.vehicleType.size() <= 120 &&
        (data.freight is int || data.freight is float) &&
        isValidOptStr(data, 'loadingCharge', 120) &&
        isValidOptStr(data, 'unloadingCharge', 120) &&
        isValidOptStr(data, 'parkingCharge', 120) &&
        isValidOptStr(data, 'detentionCharge', 120) &&
        isValidOptStr(data, 'tonGuarantee', 120) &&
        data.destination is string && data.destination.size() <= 180 &&
        isValidOptStr(data, 'advancePay', 120) &&
        isValidOptStr(data, 'entryPoint', 120) &&
        isValidOptStr(data, 'branchCode', 32) &&
        isValidOptStr(data, 'createdByStaff', 64) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLorryHire(data) {
      return data.keys().hasAll(['cnNo', 'truckNo', 'hireAmount', 'advancePaid', 'balancePayable', 'podReceived', 'balancePaid', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'cnNo', 'cnDate', 'truckNo', 'ownerName', 'fromCity', 'toCity',
          'hireAmount', 'advancePaid', 'balancePayable', 'podReceived', 'podReceiveDate',
          'podImageDataUrl', 'podFileName', 'balancePaid', 'balancePaidDate',
          'paymentMode', 'paymentRef', 'branchCode', 'createdByStaff', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        data.cnNo is string && data.cnNo.size() >= 2 && data.cnNo.size() <= 40 &&
        isValidOptStr(data, 'cnDate', 20) &&
        data.truckNo is string && data.truckNo.size() >= 3 && data.truckNo.size() <= 30 &&
        isValidOptStr(data, 'ownerName', 140) &&
        isValidOptStr(data, 'fromCity', 120) &&
        isValidOptStr(data, 'toCity', 120) &&
        (data.hireAmount is int || data.hireAmount is float) &&
        (data.advancePaid is int || data.advancePaid is float) &&
        (data.balancePayable is int || data.balancePayable is float) &&
        data.podReceived is bool &&
        isValidOptStr(data, 'podReceiveDate', 20) &&
        isValidOptStr(data, 'podImageDataUrl', 450000) &&
        isValidOptStr(data, 'podFileName', 160) &&
        data.balancePaid is bool &&
        (data.balancePaid == false || (
          data.podReceived == true &&
          ('podReceiveDate' in data) && data.podReceiveDate is string && data.podReceiveDate.size() >= 8 &&
          ('podFileName' in data) && data.podFileName is string && data.podFileName.size() >= 1
        )) &&
        isValidOptStr(data, 'balancePaidDate', 20) &&
        isValidOptStr(data, 'paymentMode', 40) &&
        isValidOptStr(data, 'paymentRef', 80) &&
        isValidOptStr(data, 'branchCode', 32) &&
        isValidOptStr(data, 'createdByStaff', 64) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['txCode', 'txDate', 'txType', 'ledgerAccount', 'partyName', 'amount', 'paymentMode', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'txCode', 'txDate', 'txType', 'ledgerAccount', 'partyName', 'amount',
          'narration', 'paymentMode', 'referenceNo', 'linkedCnNo', 'linkedInvoiceNo',
          'branchCode', 'createdByStaff', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        data.txCode is string && data.txCode.size() >= 2 && data.txCode.size() <= 32 &&
        data.txDate is string && data.txDate.size() >= 8 && data.txDate.size() <= 20 &&
        data.txType in ['Income', 'Expense'] &&
        data.ledgerAccount is string && data.ledgerAccount.size() >= 1 && data.ledgerAccount.size() <= 100 &&
        data.partyName is string && data.partyName.size() >= 1 && data.partyName.size() <= 180 &&
        (data.amount is int || data.amount is float) &&
        isValidOptStr(data, 'narration', 300) &&
        data.paymentMode is string && data.paymentMode.size() <= 60 &&
        isValidOptStr(data, 'referenceNo', 80) &&
        isValidOptStr(data, 'linkedCnNo', 40) &&
        isValidOptStr(data, 'linkedInvoiceNo', 40) &&
        isValidOptStr(data, 'branchCode', 32) &&
        isValidOptStr(data, 'createdByStaff', 64) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDeclaration(data) {
      return data.keys().hasAll(['partyName', 'financialYear', 'declarationDate', 'place', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'partyName', 'partyAddress', 'partyGstin', 'financialYear', 'declarationDate',
          'place', 'branchCode', 'createdByStaff', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        data.partyName is string && data.partyName.size() >= 1 && data.partyName.size() <= 180 &&
        isValidOptStr(data, 'partyAddress', 350) &&
        isValidOptStr(data, 'partyGstin', 24) &&
        data.financialYear is string && data.financialYear.size() >= 7 && data.financialYear.size() <= 12 &&
        data.declarationDate is string && data.declarationDate.size() >= 8 && data.declarationDate.size() <= 20 &&
        data.place is string && data.place.size() <= 80 &&
        isValidOptStr(data, 'branchCode', 32) &&
        isValidOptStr(data, 'createdByStaff', 64) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['companyName', 'pan', 'gstin', 'ownerUid', 'updatedAt']) &&
        data.keys().hasOnly([
          'companyName', 'tagline', 'address', 'pan', 'gstin', 'msme', 'hsn',
          'phones', 'email', 'bankName', 'bankBranch', 'accountNo', 'ifsc', 'swift',
          'currentFy', 'ownerUid', 'updatedAt'
        ]) &&
        data.companyName is string && data.companyName.size() <= 160 &&
        isValidOptStr(data, 'tagline', 160) &&
        isValidOptStr(data, 'address', 350) &&
        data.pan is string && data.pan.size() <= 20 &&
        data.gstin is string && data.gstin.size() <= 24 &&
        isValidOptStr(data, 'msme', 60) &&
        isValidOptStr(data, 'hsn', 20) &&
        isValidOptStr(data, 'phones', 80) &&
        isValidOptStr(data, 'email', 160) &&
        isValidOptStr(data, 'bankName', 120) &&
        isValidOptStr(data, 'bankBranch', 120) &&
        isValidOptStr(data, 'accountNo', 40) &&
        isValidOptStr(data, 'ifsc', 24) &&
        isValidOptStr(data, 'swift', 24) &&
        isValidOptStr(data, 'currentFy', 12) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.updatedAt is timestamp;
    }

    function isValidCounter(data) {
      return data.keys().hasAll(['seq', 'prefix', 'fy', 'ownerUid', 'updatedAt']) &&
        data.keys().hasOnly(['seq', 'prefix', 'fy', 'branchCode', 'lastUpdatedBy', 'ownerUid', 'updatedAt']) &&
        (data.seq is int || data.seq is float) && data.seq >= 1 &&
        data.prefix is string && data.prefix.size() >= 1 && data.prefix.size() <= 20 &&
        data.fy is string && data.fy.size() >= 2 && data.fy.size() <= 12 &&
        isValidOptStr(data, 'branchCode', 32) &&
        isValidOptStr(data, 'lastUpdatedBy', 64) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.updatedAt is timestamp;
    }

    function isValidPresence(data) {
      return data.keys().hasAll(['staffCode', 'displayName', 'role', 'branchCode', 'status', 'ownerUid', 'lastSeenAt']) &&
        data.keys().hasOnly(['staffCode', 'displayName', 'role', 'branchCode', 'activeModule', 'deviceType', 'status', 'ownerUid', 'lastSeenAt']) &&
        data.staffCode is string && data.staffCode.size() >= 1 && data.staffCode.size() <= 32 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 32 &&
        data.branchCode is string && data.branchCode.size() >= 1 && data.branchCode.size() <= 32 &&
        isValidOptStr(data, 'activeModule', 64) &&
        isValidOptStr(data, 'deviceType', 40) &&
        data.status in ['online', 'offline'] &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.lastSeenAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['action', 'module', 'summary', 'staffCode', 'branchCode', 'ownerUid', 'createdAt']) &&
        data.keys().hasOnly(['action', 'module', 'docRefCode', 'summary', 'staffCode', 'staffName', 'branchCode', 'ownerUid', 'createdAt']) &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
        data.module is string && data.module.size() >= 1 && data.module.size() <= 40 &&
        isValidOptStr(data, 'docRefCode', 80) &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300 &&
        data.staffCode is string && data.staffCode.size() >= 1 && data.staffCode.size() <= 32 &&
        isValidOptStr(data, 'staffName', 100) &&
        data.branchCode is string && data.branchCode.size() >= 1 && data.branchCode.size() <= 32 &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp;
    }

    // 4. Collection Match Blocks
    match /test/connection {
      allow get: if request.auth != null;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (adminId == request.auth.uid || isAdmin());
      allow list: if isMasterEmail();
      allow create, update, delete: if isAdmin() && isValidId(adminId) && isValidAdminUser(incoming());
    }

    match /staff_accounts/{staffId} {
      allow get: if isSignedIn() && isValidId(staffId) && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isListOwnerOrMaster();
      allow create: if (isAdmin() || (isSignedIn() && incoming().ownerUid == request.auth.uid && incoming().role != 'Admin')) &&
        isValidId(staffId) &&
        isValidStaffAccount(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(staffId) &&
        isValidStaffAccount(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            isOwnerOrAdmin() &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'branchCode', 'pinHash', 'active', 'permissions', 'updatedAt'])
          )
        );
      allow delete: if isValidId(staffId) && isOwnerOrAdmin();
    }

    match /parties/{partyId} {
      allow get: if isValidId(partyId) && isOwnerOrAdmin();
      allow list: if isListOwnerOrMaster();
      allow create: if isSignedIn() && isValidId(partyId) && isValidParty(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(partyId) && isValidParty(incoming()) && isOwnerOrAdmin() &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'partyType', 'address', 'gstin', 'pan', 'phone', 'email', 'openingBalance', 'currentBalance', 'balanceType', 'updatedAt'])
        );
