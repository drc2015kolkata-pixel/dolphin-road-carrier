        data.docketNo is string && data.docketNo.size() >= 2 && data.docketNo.size() <= 40 &&
        data.docketDate is string && data.docketDate.size() >= 8 && data.docketDate.size() <= 20 &&
        isValidOptStr(data, 'financialYear', 16) &&
        data.originBranch is string && data.originBranch.size() <= 32 &&
        data.destBranch is string && data.destBranch.size() <= 32 &&
        isValidOptStr(data, 'deliveryMode', 30) &&
        data.payMode in ['Paid', 'To-Pay', 'TBB'] &&
        data.consignorName is string && data.consignorName.size() <= 180 &&
        isValidOptStr(data, 'consignorAddress', 350) &&
        isValidOptStr(data, 'consignorGstin', 24) &&
        data.consigneeName is string && data.consigneeName.size() <= 180 &&
        isValidOptStr(data, 'consigneeAddress', 350) &&
        isValidOptStr(data, 'consigneeGstin', 24) &&
        isValidOptStr(data, 'billingPartyName', 180) &&
        isValidOptNum(data, 'packages') &&
        isValidOptStr(data, 'packingType', 60) &&
        isValidOptStr(data, 'goodsDesc', 300) &&
        isValidOptNum(data, 'actualWeightKg') &&
        isValidOptNum(data, 'chargedWeightKg') &&
        isValidOptStr(data, 'rateBasis', 80) &&
        isValidOptNum(data, 'ratePerUnit') &&
        isValidOptNum(data, 'baseFreight') &&
        isValidOptNum(data, 'fovCharge') &&
        isValidOptNum(data, 'docketCharge') &&
        isValidOptNum(data, 'hamaliCharge') &&
        isValidOptNum(data, 'doorCharge') &&
        isValidOptNum(data, 'gstRate') &&
        isValidOptNum(data, 'cgstAmt') &&
        isValidOptNum(data, 'sgstAmt') &&
        isValidOptNum(data, 'igstAmt') &&
        isValidOptBool(data, 'reverseCharge') &&
        (data.totalAmount is int || data.totalAmount is float) &&
        isValidOptStr(data, 'ewayBillNo', 60) &&
        isValidOptStr(data, 'ewayBillValidUpto', 30) &&
        isValidOptNum(data, 'valueOfGoods') &&
        data.stockStage in ['Origin Godown', 'Manifested / In Transit', 'Destination Godown', 'Out for Delivery', 'Delivered'] &&
        isValidOptStr(data, 'godownRack', 40) &&
        isValidOptStr(data, 'godownBranch', 32) &&
        isValidOptStr(data, 'manifestId', 128) &&
        isValidOptStr(data, 'manifestNo', 40) &&
        isValidOptStr(data, 'invoiceId', 128) &&
        data.billed is bool &&
        isValidOptStr(data, 'podImageDataUrl', 450000) &&
        isValidOptStr(data, 'podDate', 20) &&
        isValidOptStr(data, 'remarks', 500) &&
        isValidOptStr(data, 'branchCode', 32) &&
        isValidOptStr(data, 'createdByStaff', 64) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLogisticsManifest(data) {
      return data.keys().hasAll(['manifestNo', 'manifestDate', 'fromBranch', 'toBranch', 'truckNo', 'docketIds', 'status', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'manifestNo', 'manifestDate', 'financialYear', 'fromBranch', 'toBranch',
          'truckNo', 'driverName', 'driverPhone', 'brokerName', 'docketIds', 'docketNos',
          'totalPkgs', 'totalWeightKg', 'totalTopayAmount', 'hireAmount', 'advancePaid',
          'balancePayable', 'status', 'arrivalDate', 'remarks', 'branchCode', 'createdByStaff',
          'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidOptStr(data, 'id', 128) &&
        data.manifestNo is string && data.manifestNo.size() >= 2 && data.manifestNo.size() <= 40 &&
        data.manifestDate is string && data.manifestDate.size() >= 8 && data.manifestDate.size() <= 20 &&
        isValidOptStr(data, 'financialYear', 16) &&
        data.fromBranch is string && data.fromBranch.size() <= 32 &&
        data.toBranch is string && data.toBranch.size() <= 32 &&
        data.truckNo is string && data.truckNo.size() <= 30 &&
        isValidOptStr(data, 'driverName', 140) &&
        isValidOptStr(data, 'driverPhone', 30) &&
        isValidOptStr(data, 'brokerName', 140) &&
        data.docketIds is list && data.docketIds.size() <= 200 &&
        isValidOptList(data, 'docketNos', 200) &&
        isValidOptNum(data, 'totalPkgs') &&
        isValidOptNum(data, 'totalWeightKg') &&
        isValidOptNum(data, 'totalTopayAmount') &&
        isValidOptNum(data, 'hireAmount') &&
        isValidOptNum(data, 'advancePaid') &&
        isValidOptNum(data, 'balancePayable') &&
        data.status in ['Dispatched', 'In Transit', 'Arrived', 'Unloaded'] &&
        isValidOptStr(data, 'arrivalDate', 20) &&
        isValidOptStr(data, 'remarks', 500) &&
        isValidOptStr(data, 'branchCode', 32) &&
        isValidOptStr(data, 'createdByStaff', 64) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLogisticsInvoice(data) {
      return data.keys().hasAll(['docType', 'docNo', 'docDate', 'partyName', 'grandTotal', 'paidAmount', 'status', 'docketRows', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'docType', 'docNo', 'docDate', 'financialYear', 'linkedDocNo', 'partyName',
          'partyAddress', 'partyGstin', 'partyPan', 'sac', 'reverseCharge', 'interstate',
          'gstRate', 'taxableAmount', 'cgstAmt', 'sgstAmt', 'igstAmt', 'grandTotal',
          'paidAmount', 'status', 'docketRows', 'selectedBankId', 'remarks', 'branchCode',
          'createdByStaff', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
