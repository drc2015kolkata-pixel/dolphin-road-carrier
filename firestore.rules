        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLogisticsLedger(data) {
      return data.keys().hasAll(['voucherNo', 'voucherDate', 'voucherType', 'partyName', 'amount', 'paymentMode', 'narration', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
