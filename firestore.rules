        data.docDate is string && data.docDate.size() >= 8 && data.docDate.size() <= 20 &&
        isValidOptStr(data, 'financialYear', 16) &&
        isValidOptStr(data, 'linkedDocNo', 40) &&
        data.partyName is string && data.partyName.size() >= 1 && data.partyName.size() <= 180 &&
        isValidOptStr(data, 'partyAddress', 350) &&
        isValidOptStr(data, 'partyGstin', 24) &&
        isValidOptStr(data, 'partyPan', 15) &&
        isValidOptStr(data, 'sac', 20) &&
        isValidOptBool(data, 'reverseCharge') &&
        isValidOptBool(data, 'interstate') &&
        isValidOptNum(data, 'gstRate') &&
        isValidOptNum(data, 'taxableAmount') &&
