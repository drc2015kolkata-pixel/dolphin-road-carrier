rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isMasterEmail() {
      return isSignedIn() && request.auth.token.email == 'drc.2015kolkata@gmail.com';
    }

    function isAdmin() {
      return isMasterEmail() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwnerOrAdmin() {
      return isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    function isListOwnerOrMaster() {
      return isSignedIn() && (resource.data.ownerUid == request.auth.uid || request.auth.token.email == 'drc.2015kolkata@gmail.com');
    }

    function isValidOptStr(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidOptNum(data, key) {
      return !(key in data) || (data[key] is int || data[key] is float);
    }

    function isValidOptBool(data, key) {
      return !(key in data) || data[key] is bool;
    }

    function isValidOptList(data, key, maxLen) {
      return !(key in data) || (data[key] is list && data[key].size() <= maxLen);
    }

    function isValidOptMap(data, key, maxKeys) {
      return !(key in data) || (data[key] is map && data[key].keys().size() <= maxKeys);
    }

    // 3. Entity Validation Blueprints
    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
        data.keys().hasOnly(['email', 'displayName', 'createdAt']) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        isValidOptStr(data, 'displayName', 120) &&
        data.createdAt is timestamp;
    }

    function isValidStaffAccount(data) {
      return data.keys().hasAll(['staffCode', 'displayName', 'role', 'pinHash', 'active', 'permissions', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'staffCode', 'displayName', 'role', 'branchCode', 'bankName', 'bankAccountNo', 'bankIfsc', 'upiId', 'pinHash', 'active', 'permissions', 'sheetPermissions', 'ownerUid', 'createdAt', 'updatedAt']) &&
        isValidOptStr(data, 'id', 128) &&
        data.staffCode is string && data.staffCode.size() >= 2 && data.staffCode.size() <= 32 && data.staffCode.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100 &&
        data.role in ['Admin', 'Manager', 'Billing', 'Accounts', 'Dispatch', 'Viewer'] &&
        isValidOptStr(data, 'branchCode', 32) &&
        isValidOptStr(data, 'bankName', 120) &&
        isValidOptStr(data, 'bankAccountNo', 40) &&
        isValidOptStr(data, 'bankIfsc', 20) &&
        isValidOptStr(data, 'upiId', 120) &&
        data.pinHash is string && data.pinHash.size() >= 4 && data.pinHash.size() <= 128 &&
        data.active is bool &&
        data.permissions is list && data.permissions.size() <= 12 &&
        (data.permissions.size() == 0 || data.permissions[0] is string) &&
        isValidOptMap(data, 'sheetPermissions', 20) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidParty(data) {
      return data.keys().hasAll(['name', 'partyType', 'openingBalance', 'currentBalance', 'balanceType', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'name', 'partyCode', 'partyType', 'address', 'city', 'pinCode', 'country',
          'stateCode', 'stateName', 'gstStateCode', 'gstStateName', 'contactPerson',
          'gstin', 'pan', 'aadhaarNo', 'tradeLicenseNo',
          'bankName', 'bankAccountNo', 'bankIfsc', 'phone', 'email', 'preferredChannel',
          'firstOwnerName', 'secondOwnerName', 'deedNo', 'deedDate',
          'openingBalance', 'currentBalance', 'balanceType', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidOptStr(data, 'id', 128) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 180 &&
        isValidOptStr(data, 'partyCode', 40) &&
        data.partyType in ['Customer', 'Consignor', 'Consignee', 'TruckOwner', 'Broker', 'Vendor'] &&
        isValidOptStr(data, 'address', 400) &&
        isValidOptStr(data, 'city', 100) &&
        isValidOptStr(data, 'pinCode', 20) &&
        isValidOptStr(data, 'country', 40) &&
        isValidOptStr(data, 'stateCode', 10) &&
        isValidOptStr(data, 'stateName', 80) &&
        isValidOptStr(data, 'gstStateCode', 10) &&
        isValidOptStr(data, 'gstStateName', 80) &&
        isValidOptStr(data, 'contactPerson', 120) &&
        isValidOptStr(data, 'gstin', 20) &&
        isValidOptStr(data, 'pan', 15) &&
        isValidOptStr(data, 'aadhaarNo', 24) &&
        isValidOptStr(data, 'tradeLicenseNo', 60) &&
        isValidOptStr(data, 'bankName', 120) &&
        isValidOptStr(data, 'bankAccountNo', 40) &&
        isValidOptStr(data, 'bankIfsc', 20) &&
        isValidOptStr(data, 'phone', 30) &&
        isValidOptStr(data, 'email', 160) &&
        isValidOptStr(data, 'preferredChannel', 40) &&
        isValidOptStr(data, 'firstOwnerName', 180) &&
        isValidOptStr(data, 'secondOwnerName', 180) &&
        isValidOptStr(data, 'deedNo', 60) &&
        isValidOptStr(data, 'deedDate', 20) &&
        (data.openingBalance is int || data.openingBalance is float) &&
        (data.currentBalance is int || data.currentBalance is float) &&
        data.balanceType in ['Dr', 'Cr'] &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVehicle(data) {
      return data.keys().hasAll(['truckNo', 'ownerName', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'truckNo', 'vehicleType', 'vehicleMake', 'bodyType', 'vehicleColor', 'ownerName', 'ownerPhone', 'engineNo', 'chassisNo', 'fitnessExpiry', 'insuranceExpiry', 'permitExpiry', 'roadTaxExpiry', 'pucExpiry', 'ownerUid', 'createdAt', 'updatedAt']) &&
        isValidOptStr(data, 'id', 128) &&
        data.truckNo is string && data.truckNo.size() >= 4 && data.truckNo.size() <= 24 &&
        isValidOptStr(data, 'vehicleType', 80) &&
        isValidOptStr(data, 'vehicleMake', 80) &&
        isValidOptStr(data, 'bodyType', 80) &&
        isValidOptStr(data, 'vehicleColor', 60) &&
        data.ownerName is string && data.ownerName.size() <= 140 &&
        isValidOptStr(data, 'ownerPhone', 30) &&
        isValidOptStr(data, 'engineNo', 40) &&
        isValidOptStr(data, 'chassisNo', 40) &&
        isValidOptStr(data, 'fitnessExpiry', 20) &&
        isValidOptStr(data, 'insuranceExpiry', 20) &&
        isValidOptStr(data, 'permitExpiry', 20) &&
        isValidOptStr(data, 'roadTaxExpiry', 20) &&
        isValidOptStr(data, 'pucExpiry', 20) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDriver(data) {
      return data.keys().hasAll(['name', 'dlNo', 'dlExpiry', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'dlNo', 'dlExpiry', 'phone', 'address', 'aadhaarNo', 'panNo', 'bankName', 'bankAccountNo', 'bankIfsc', 'ownerUid', 'createdAt', 'updatedAt']) &&
        isValidOptStr(data, 'id', 128) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
        data.dlNo is string && data.dlNo.size() >= 4 && data.dlNo.size() <= 40 &&
        data.dlExpiry is string && data.dlExpiry.size() <= 20 &&
        isValidOptStr(data, 'phone', 30) &&
        isValidOptStr(data, 'address', 300) &&
        isValidOptStr(data, 'aadhaarNo', 24) &&
        isValidOptStr(data, 'panNo', 15) &&
        isValidOptStr(data, 'bankName', 120) &&
        isValidOptStr(data, 'bankAccountNo', 40) &&
        isValidOptStr(data, 'bankIfsc', 20) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConsignmentPartA(data) {
      return isValidOptStr(data, 'id', 128) &&
        data.cnNo is string && data.cnNo.size() >= 2 && data.cnNo.size() <= 40 &&
        data.cnDate is string && data.cnDate.size() >= 8 && data.cnDate.size() <= 20 &&
        isValidOptStr(data, 'financialYear', 16) &&
        isValidOptStr(data, 'division', 20) &&
        isValidOptStr(data, 'branchShort', 30) &&
        isValidOptStr(data, 'lastCnNo', 40) &&
        isValidOptStr(data, 'refCnNo', 40) &&
        isValidOptStr(data, 'transportMode', 30) &&
        isValidOptStr(data, 'bookingBasis', 30) &&
        isValidOptStr(data, 'payBasis', 30) &&
        isValidOptStr(data, 'billedAtBranch', 80) &&
        isValidOptBool(data, 'hasVehicleNo') &&
        isValidOptStr(data, 'deliveryOffice', 200) &&
        isValidOptStr(data, 'deliveryType', 40) &&
        isValidOptStr(data, 'freightMode', 30) &&
        isValidOptStr(data, 'originGstStateCode', 10) &&
        isValidOptStr(data, 'destGstStateCode', 10) &&
        isValidOptBool(data, 'stockTransfer') &&
        isValidOptStr(data, 'billingPartyName', 180) &&
        isValidOptBool(data, 'billToPartyFlag') &&
        isValidOptNum(data, 'creditDays') &&
        data.consignorName is string && data.consignorName.size() <= 180 &&
        isValidOptStr(data, 'consignorAddress', 350) &&
        isValidOptStr(data, 'consignorPinCode', 20) &&
        isValidOptStr(data, 'consignorCountry', 40) &&
        isValidOptStr(data, 'consignorGstin', 24) &&
        isValidOptStr(data, 'consignorHsn', 20) &&
        data.consigneeName is string && data.consigneeName.size() <= 180 &&
        isValidOptStr(data, 'consigneeAddress', 350) &&
        isValidOptStr(data, 'consigneePinCode', 20) &&
        isValidOptStr(data, 'consigneeCountry', 40) &&
        isValidOptStr(data, 'consigneeGstin', 24) &&
        isValidOptStr(data, 'consigneeHsn', 20) &&
        isValidOptStr(data, 'deliverAt', 180) &&
        isValidOptBool(data, 'isChallanAttached') &&
        isValidOptStr(data, 'packages', 40) &&
        isValidOptStr(data, 'packageMode', 60) &&
        isValidOptStr(data, 'particulars', 400) &&
        isValidOptList(data, 'multiGoodsItems', 50) &&
        isValidOptStr(data, 'rateMode', 80) &&
        isValidOptNum(data, 'ratePerUnit') &&
        isValidOptNum(data, 'nettWeight') &&
        isValidOptNum(data, 'grossWeight') &&
        isValidOptNum(data, 'chargedWeight') &&
        isValidOptList(data, 'multiWeights', 50) &&
        isValidOptNum(data, 'loadingCharge') &&
        isValidOptNum(data, 'unloadingCharge') &&
        isValidOptNum(data, 'returnLorryCharge') &&
        isValidOptNum(data, 'sttCharge') &&
        isValidOptNum(data, 'otherCharge') &&
        (data.totalFreight is int || data.totalFreight is float) &&
        isValidOptBool(data, 'showFreightOnPrint') &&
        isValidOptNum(data, 'paidAmount') &&
        isValidOptNum(data, 'toPayAmount');
    }

    function isValidConsignmentPartB(data) {
      return isValidOptBool(data, 'hasTaxInvoice') &&
        isValidOptBool(data, 'hasMultiEwayBill') &&
        isValidOptBool(data, 'hasMultiVehicle') &&
        isValidOptStr(data, 'taxInvNo', 80) &&
        isValidOptStr(data, 'taxInvDate', 20) &&
        isValidOptStr(data, 'ewayBillNo', 60) &&
        isValidOptStr(data, 'ewayBillDate', 20) &&
        isValidOptStr(data, 'ewayBillValidUpto', 30) &&
        isValidOptStr(data, 'ewayPlace', 120) &&
        isValidOptStr(data, 'ewayPinCode', 20) &&
        isValidOptList(data, 'ewbExtensions', 15) &&
        isValidOptList(data, 'extraTaxInvoices', 50) &&
        isValidOptList(data, 'extraEwayBills', 50) &&
        isValidOptList(data, 'extraVehicles', 30) &&
        isValidOptNum(data, 'valueOfGoods') &&
        data.truckNo is string && data.truckNo.size() <= 30 &&
        isValidOptStr(data, 'fromState', 80) &&
        isValidOptStr(data, 'fromDistrict', 80) &&
        data.fromCity is string && data.fromCity.size() <= 120 &&
        isValidOptStr(data, 'fromPinCode', 20) &&
        isValidOptStr(data, 'fromCountry', 40) &&
        isValidOptStr(data, 'toState', 80) &&
        isValidOptStr(data, 'toDistrict', 80) &&
        data.toCity is string && data.toCity.size() <= 120 &&
        isValidOptStr(data, 'toPinCode', 20) &&
        isValidOptStr(data, 'toCountry', 40) &&
        isValidOptStr(data, 'engineNo', 40) &&
        isValidOptStr(data, 'chassisNo', 40) &&
        isValidOptStr(data, 'ownerName', 140) &&
        isValidOptStr(data, 'brokerName', 140) &&
        isValidOptStr(data, 'driverName', 140) &&
        isValidOptStr(data, 'driverDlNo', 40) &&
        isValidOptStr(data, 'driverDlExpiry', 20) &&
        isValidOptStr(data, 'driverMobile', 30) &&
        isValidOptStr(data, 'deliveryModeCode', 10) &&
        isValidOptStr(data, 'gstPaidBy', 40) &&
        isValidOptStr(data, 'gstPaidByCode', 10) &&
        isValidOptStr(data, 'riskTakenBy', 10) &&
        isValidOptStr(data, 'insuranceStatus', 80) &&
        isValidOptStr(data, 'insuranceCo', 120) &&
        isValidOptStr(data, 'insurancePolicyNo', 80) &&
        isValidOptStr(data, 'insurancePolicyDate', 20) &&
        isValidOptNum(data, 'insuranceAmount') &&
        isValidOptList(data, 'extraInsurances', 50) &&
        isValidOptList(data, 'multiInsurances', 50) &&
        isValidOptStr(data, 'billAdjustmentDetails', 500) &&
        isValidOptBool(data, 'addlDetailsEnabled') &&
        isValidOptStr(data, 'remarks', 1200) &&
        isValidOptStr(data, 'scannedLrDataUrl', 450000) &&
        data.billed is bool &&
        isValidOptStr(data, 'invoiceId', 128) &&
        isValidOptStr(data, 'branchCode', 32) &&
        isValidOptStr(data, 'createdByStaff', 64) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConsignment(data) {
      return data.keys().hasAll(['cnNo', 'cnDate', 'consignorName', 'consigneeName', 'truckNo', 'fromCity', 'toCity', 'totalFreight', 'billed', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'cnNo', 'cnDate', 'financialYear', 'division', 'branchShort', 'lastCnNo', 'refCnNo',
          'transportMode', 'bookingBasis', 'payBasis', 'billedAtBranch', 'hasVehicleNo', 'deliveryOffice',
          'deliveryType', 'freightMode', 'originGstStateCode', 'destGstStateCode',
          'stockTransfer', 'billingPartyName', 'billToPartyFlag', 'creditDays',
          'consignorName', 'consignorAddress', 'consignorPinCode', 'consignorCountry', 'consignorGstin', 'consignorHsn',
          'consigneeName', 'consigneeAddress', 'consigneePinCode', 'consigneeCountry', 'consigneeGstin', 'consigneeHsn', 'deliverAt', 'isChallanAttached',
          'packages', 'packageMode', 'particulars', 'multiGoodsItems',
          'rateMode', 'ratePerUnit', 'nettWeight', 'grossWeight', 'chargedWeight', 'multiWeights', 'loadingCharge', 'unloadingCharge',
          'returnLorryCharge', 'sttCharge', 'otherCharge', 'totalFreight', 'showFreightOnPrint', 'paidAmount', 'toPayAmount',
          'hasTaxInvoice', 'hasMultiEwayBill', 'hasMultiVehicle', 'taxInvNo', 'taxInvDate', 'ewayBillNo', 'ewayBillDate', 'ewayBillValidUpto',
          'ewayPlace', 'ewayPinCode',
          'ewbExtensions', 'extraTaxInvoices', 'extraEwayBills', 'extraVehicles',
          'valueOfGoods', 'truckNo', 'fromState', 'fromDistrict', 'fromCity', 'fromPinCode', 'fromCountry',
          'toState', 'toDistrict', 'toCity', 'toPinCode', 'toCountry',
          'engineNo', 'chassisNo', 'ownerName', 'brokerName', 'driverName', 'driverDlNo', 'driverDlExpiry', 'driverMobile',
          'deliveryModeCode', 'gstPaidBy', 'gstPaidByCode', 'riskTakenBy', 'insuranceStatus', 'insuranceCo',
          'insurancePolicyNo', 'insurancePolicyDate', 'insuranceAmount', 'extraInsurances', 'multiInsurances',
          'billAdjustmentDetails', 'addlDetailsEnabled',
          'remarks', 'scannedLrDataUrl', 'billed', 'invoiceId',
          'branchCode', 'createdByStaff', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidConsignmentPartA(data) &&
        isValidConsignmentPartB(data);
    }

    function isValidInvoicePartA(data) {
      return isValidOptStr(data, 'id', 128) &&
        isValidOptStr(data, 'billId', 40) &&
        data.invoiceNo is string && data.invoiceNo.size() >= 2 && data.invoiceNo.size() <= 40 &&
        data.invoiceDate is string && data.invoiceDate.size() >= 8 && data.invoiceDate.size() <= 20 &&
        isValidOptStr(data, 'dueDate', 20) &&
        isValidOptStr(data, 'financialYear', 16) &&
        isValidOptStr(data, 'division', 20) &&
        isValidOptStr(data, 'billedByCode', 10) &&
        isValidOptStr(data, 'billedAtBranch', 80) &&
        isValidOptStr(data, 'poWorkOrderNo', 80) &&
        isValidOptNum(data, 'creditDays') &&
        isValidOptStr(data, 'docKind', 30) &&
        isValidOptStr(data, 'againstInvoiceId', 128) &&
        isValidOptStr(data, 'againstInvoiceNo', 40) &&
        isValidOptBool(data, 'finalized') &&
        isValidOptStr(data, 'narrationText', 500) &&
        isValidOptNum(data, 'roundOffAmt') &&
        data.partyName is string && data.partyName.size() >= 1 && data.partyName.size() <= 180 &&
        isValidOptStr(data, 'partyAddress', 350) &&
        isValidOptStr(data, 'partyGstin', 24) &&
        isValidOptStr(data, 'partyStateCode', 10) &&
        isValidOptStr(data, 'partyStateName', 80) &&
        isValidOptStr(data, 'partyPan', 15) &&
        isValidOptStr(data, 'billingCountry', 40) &&
        isValidOptStr(data, 'sac', 20) &&
        isValidOptBool(data, 'reverseCharge') &&
        isValidOptBool(data, 'interstate') &&
        isValidOptStr(data, 'gstPaidBy', 40);
    }

    function isValidInvoicePartB(data) {
      return isValidOptNum(data, 'gstRate') &&
        isValidOptNum(data, 'cgstAmt') &&
        isValidOptNum(data, 'sgstAmt') &&
        isValidOptNum(data, 'igstAmt') &&
        isValidOptNum(data, 'totalTax') &&
        isValidOptNum(data, 'freightCharges') &&
        isValidOptNum(data, 'insuranceCharge') &&
        isValidOptNum(data, 'collCharge') &&
        isValidOptNum(data, 'loadingCharge') &&
        isValidOptNum(data, 'detentionCharges') &&
        isValidOptNum(data, 'unloadingCharges') &&
        isValidOptNum(data, 'surchargeAmt') &&
        isValidOptNum(data, 'stCharges') &&
        isValidOptNum(data, 'fumigationCharge') &&
        isValidOptNum(data, 'extraCharge') &&
        isValidOptNum(data, 'grossBillAmount') &&
        isValidOptNum(data, 'advanceReceived') &&
        isValidOptStr(data, 'advanceMode', 60) &&
        isValidOptStr(data, 'fullPaymentMode', 60) &&
        (data.grandTotal is int || data.grandTotal is float) &&
        isValidOptBool(data, 'manualTotalOverride') &&
        isValidOptStr(data, 'creditDebitReason', 300) &&
        (data.paidAmount is int || data.paidAmount is float) &&
        data.status in ['Unpaid', 'Partial', 'Paid'] &&
        isValidOptStr(data, 'remarks', 500) &&
        isValidOptStr(data, 'billFootnote', 500) &&
        isValidOptStr(data, 'additionalNotes', 1200) &&
        isValidOptNum(data, 'copyCount') &&
        data.consignmentRows is list && data.consignmentRows.size() >= 1 && data.consignmentRows.size() <= 100 &&
        data.consignmentRows[0] is map &&
        isValidOptList(data, 'annexureLorries', 100) &&
        isValidOptStr(data, 'selectedBankId', 80) &&
        isValidOptStr(data, 'branchOfficeId', 80) &&
        isValidOptStr(data, 'branchCode', 32) &&
        isValidOptStr(data, 'createdByStaff', 64) &&
        data.ownerUid is string && data.ownerUid.size() >= 6 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['invoiceNo', 'invoiceDate', 'partyName', 'grandTotal', 'paidAmount', 'status', 'consignmentRows', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'billId', 'invoiceNo', 'invoiceDate', 'dueDate', 'financialYear', 'division', 'billedByCode', 'billedAtBranch',
          'poWorkOrderNo', 'creditDays', 'docKind', 'againstInvoiceId', 'againstInvoiceNo', 'finalized', 'narrationText', 'roundOffAmt',
          'partyName', 'partyAddress', 'partyGstin', 'partyStateCode', 'partyStateName', 'partyPan',
          'billingCountry', 'sac', 'reverseCharge', 'interstate', 'gstPaidBy', 'gstRate', 'cgstAmt', 'sgstAmt', 'igstAmt', 'totalTax',
          'freightCharges', 'insuranceCharge', 'collCharge', 'loadingCharge', 'detentionCharges', 'unloadingCharges', 'surchargeAmt',
          'stCharges', 'fumigationCharge', 'extraCharge', 'grossBillAmount', 'advanceReceived', 'advanceMode', 'fullPaymentMode',
          'grandTotal', 'manualTotalOverride', 'creditDebitReason',
          'paidAmount', 'status', 'remarks', 'billFootnote', 'additionalNotes', 'copyCount', 'consignmentRows', 'annexureLorries',
          'selectedBankId', 'branchOfficeId', 'branchCode', 'createdByStaff', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidInvoicePartA(data) &&
        isValidInvoicePartB(data);
    }

    function isValidQuotation(data) {
      return data.keys().hasAll(['quotationNo', 'quotationDate', 'partyName', 'vehicleType', 'freight', 'destination', 'ownerUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'quotationNo', 'quotationDate', 'financialYear', 'division', 'partyName', 'partyAddress', 'partyGstin',
          'partyPhone', 'partyEmail', 'guarantorName', 'guarantorPhone', 'acceptanceEmailOnly',
          'goodsType', 'rateMode', 'subject',
          'validityText', 'vehicleType', 'freight', 'loadingCharge', 'unloadingCharge',
          'parkingCharge', 'detentionCharge', 'tonGuarantee', 'destination', 'destinationPinCode', 'destinationCountry',
          'advancePay', 'entryPoint', 'entryPointPinCode', 'entryPointCountry', 'routeRates',
          'gstRate', 'reverseCharge', 'interstate', 'cgstAmt', 'sgstAmt', 'igstAmt', 'totalTax', 'grandTotal',
          'branchCode', 'createdByStaff', 'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        isValidOptStr(data, 'id', 128) &&
        data.quotationNo is string && data.quotationNo.size() >= 2 && data.quotationNo.size() <= 40 &&
        data.quotationDate is string && data.quotationDate.size() >= 8 && data.quotationDate.size() <= 20 &&
        isValidOptStr(data, 'financialYear', 16) &&
        isValidOptStr(data, 'division', 20) &&
        data.partyName is string && data.partyName.size() >= 1 && data.partyName.size() <= 180 &&
        isValidOptStr(data, 'partyAddress', 350) &&
        isValidOptStr(data, 'partyGstin', 24) &&
        isValidOptStr(data, 'partyPhone', 30) &&
        isValidOptStr(data, 'partyEmail', 160) &&
        isValidOptStr(data, 'guarantorName', 140) &&
        isValidOptStr(data, 'guarantorPhone', 30) &&
        isValidOptBool(data, 'acceptanceEmailOnly') &&
        isValidOptStr(data, 'goodsType', 120) &&
        isValidOptStr(data, 'rateMode', 80) &&
